# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landsafe_db

# Server
PORT=5000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string

# Cloudflare Workers AI — server-side only. Never expose these to the browser.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3.8-27b
# CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# LIA tuning (all optional)
LIA_AI_PROVIDER=cloudflare
# low keeps latency predictable; medium/xhigh trade speed for deeper reasoning.
LIA_REASONING_EFFORT=low
LIA_MAX_OUTPUT_TOKENS=2048
LIA_REQUEST_TIMEOUT_MS=60000
LIA_STREAM_TIMEOUT_MS=120000
LIA_TOOL_TIMEOUT_MS=10000
LIA_MAX_HISTORY_MESSAGES=12
LIA_MAX_TOOL_ROUNDS=3
LIA_CONTEXT_MAX_CHARS=16000
LIA_MAX_MESSAGE_LENGTH=2000
LIA_RATE_LIMIT_WINDOW_MS=60000
LIA_ANON_RATE_LIMIT=6
LIA_USER_RATE_LIMIT=20
LIA_STAFF_RATE_LIMIT=30
