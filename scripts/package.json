{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "seed": "node --env-file=../artifacts/api-server/.env --import tsx ./src/seed.ts",
    "test": "node --import tsx --test ./src/risk-prediction/domain.test.ts ./src/risk-prediction/runtime.test.ts ./src/security.test.ts",
    "ml:train": "python ./ml/train_bootstrap_model.py",
    "predict:risk": "node --env-file=../artifacts/api-server/.env --import tsx ./src/predict-risk.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "catalog:",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
